{
  "name": "stemem",
  "version": "0.1.0",
  "description": "Stemem — local-first identity-layer runtime for AI agents (MCP server). JOJO&Adam group product. Lets any MCP host give an agent a personality that grows across sessions and survives context compaction.",
  "type": "module",
  "bin": {
    "stemem": "./src/server.js"
  },
  "files": [
    "src",
    "engine",
    "host-hooks",
    "skills",
    "examples",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "snapshot": "node src/snapshot-cli.js",
    "demo": "node examples/quickstart.mjs",
    "demo:decay": "node examples/emotion-decay-demo.mjs",
    "demo:onboarding": "node examples/onboarding.mjs",
    "test": "node test/smoke.test.js && node test/integration.test.js && node test/engine.selftest.js && node test/decay.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "agent",
    "persona",
    "identity",
    "memory",
    "soulspec",
    "local-first",
    "emotion",
    "tone"
  ],
